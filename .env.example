# axcient-mcp has no required environment variables.
# Authentication is per-request via one header:
#   X-Axcient-Api-Key   Axcient partner API key, obtained at
#                       https://partner.axcient.com/ -> Settings -> API Keys.
#                       Sent to the vendor verbatim as the `x-api-key` header.
# Credentials are never read from the environment — see src/axcient_mcp/middleware.py.

MCP_HTTP_PORT=8080
MCP_HTTP_HOST=0.0.0.0
